

//index.html

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>User Registration</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
</head>
<body class="bg-light">

<div class="container mt-5">
  <div class="card p-4" style="max-width:500px; margin:auto;">
    <h4 class="mb-4 text-center">User Registration</h4>

    <div class="mb-3">
      <label>Name</label>
      <input type="text" id="name" class="form-control" placeholder="Enter name"/>
    </div>
    <div class="mb-3">
      <label>Email</label>
      <input type="email" id="email" class="form-control" placeholder="Enter email"/>
    </div>
    <div class="mb-3">
      <label>Mobile</label>
      <input type="text" id="mobile" class="form-control" placeholder="Enter mobile"/>
    </div>
    <div class="mb-3">
      <label>City</label>
      <input type="text" id="city" class="form-control" placeholder="Enter city"/>
    </div>

    <button onclick="registerUser()" class="btn btn-primary w-100">Register</button>
    <a href="list.html" class="btn btn-secondary w-100 mt-2">View All Users</a>

    <div id="msg" class="mt-3"></div>
  </div>
</div>

<script>
  function registerUser() {
    // 1. Get values from form
    var name   = document.getElementById("name").value;
    var email  = document.getElementById("email").value;
    var mobile = document.getElementById("mobile").value;
    var city   = document.getElementById("city").value;

    // 2. Simple validation
    if (name == "" || email == "" || mobile == "" || city == "") {
      document.getElementById("msg").innerHTML =
        '<div class="alert alert-danger">All fields are required!</div>';
      return;
    }

    // 3. Create user object
    var user = { name: name, email: email, mobile: mobile, city: city };

    // 4. Simulate AJAX POST using XMLHttpRequest
    var xhr = new XMLHttpRequest();

    // Since we have no real server, we simulate POST and save to localStorage
    xhr.open("POST", "https://jsonplaceholder.typicode.com/posts", true);
    xhr.setRequestHeader("Content-Type", "application/json");

    xhr.onreadystatechange = function () {
      if (xhr.readyState == 4 && xhr.status == 201) {

        // 5. Get existing users array from localStorage
        var users = JSON.parse(localStorage.getItem("users")) || [];

        // 6. Push new user into array
        users.push(user);

        // 7. Save updated array back to localStorage
        localStorage.setItem("users", JSON.stringify(users));

        // 8. Show success message
        document.getElementById("msg").innerHTML =
          '<div class="alert alert-success">User registered successfully!</div>';

        // 9. Clear the form
        document.getElementById("name").value   = "";
        document.getElementById("email").value  = "";
        document.getElementById("mobile").value = "";
        document.getElementById("city").value   = "";
      }
    };

    // 10. Send user data as JSON
    xhr.send(JSON.stringify(user));
  }
</script>

</body>
</html>







//list.html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>User List</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
</head>
<body class="bg-light">

<div class="container mt-5">
  <h4 class="mb-4 text-center">Registered Users</h4>

  <a href="index.html" class="btn btn-primary mb-3">Add New User</a>

  <table class="table table-bordered table-striped">
    <thead class="table-dark">
      <tr>
        <th>#</th>
        <th>Name</th>
        <th>Email</th>
        <th>Mobile</th>
        <th>City</th>
      </tr>
    </thead>
    <tbody id="userTable">
      <!-- Users will load here -->
    </tbody>
  </table>

  <div id="noData"></div>
</div>

<script>
  // 1. Get users array from localStorage
  var users = JSON.parse(localStorage.getItem("users")) || [];

  var tbody = document.getElementById("userTable");

  // 2. Check if any users exist
  if (users.length == 0) {
    document.getElementById("noData").innerHTML =
      '<div class="alert alert-warning">No users registered yet.</div>';
  }

  // 3. Loop through users and display in table
  for (var i = 0; i < users.length; i++) {
    var row = "<tr>" +
      "<td>" + (i + 1) + "</td>" +
      "<td>" + users[i].name   + "</td>" +
      "<td>" + users[i].email  + "</td>" +
      "<td>" + users[i].mobile + "</td>" +
      "<td>" + users[i].city   + "</td>" +
      "</tr>";

    tbody.innerHTML += row;
  }
</script>

</body>
</html>
